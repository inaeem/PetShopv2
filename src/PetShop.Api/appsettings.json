{
  "ConnectionStrings": {
    "PetShopDb": "Server=localhost;Database=PetShop;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "PetShop.Api",
    "Audience": "PetShop.Clients",
    "Modulus": "__SET_RSA_PUBLIC_KEY_MODULUS_base64url__",
    "Exponent": "AQAB"
  },
  "Cors": {
    "AllowedOrigins": "*",
    "ExposedHeaders": "Token-Expired",
    "PreflightMaxAgeSeconds": 600
  },
  "PetSync": {
    "Enabled": false,
    "BaseUrl": "https://external-pet-service.example.com",
    "CreatePetPath": "/pets",
    "ServiceToken": "",
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "RetryBaseDelayMs": 200,
    "Endpoints": [
      {
        "Name": "Acme Provider API",
        "MetaDataUrl": "https://acme.example.com/fhir/metadata",
        "SwaggerUrl": "https://acme.example.com/swagger.json",
        "Url": "https://acme.example.com/fhir",
        "Type": "Provider"
      },
      {
        "Name": "Acme Patient Portal",
        "MetaDataUrl": "https://patient.example.com/fhir/metadata",
        "SwaggerUrl": "https://patient.example.com/swagger.json",
        "Url": "https://patient.example.com/fhir",
        "Type": "Patient"
      }
    ]
  },
  "Mail": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@petshop.example.com",
    "FromName": "PetShop",
    "TimeoutSeconds": 10,
    "TemplatesPath": "EmailTemplates"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Diagnostics": {
    "LayerTracing": {
      "Enabled": true,
      "Service": true,
      "Data": true,
      "External": true,
      "Sql": false,
      "Level": "Information",
      "IncludeArguments": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/petshop-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext}{NewLine}    {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "PetShopDb",
          "sinkOptionsSection": {
            "tableName": "AppLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 100,
            "period": "0.00:00:05"
          },
          "columnOptionsSection": {
            "removeStandardColumns": [ "Properties", "MessageTemplate" ],
            "id": { "columnName": "LogId", "dataType": "bigint", "bigInt": true },
            "timeStamp": { "columnName": "LoggedAtUtc", "convertToUtc": true },
            "level": { "columnName": "Severity" },
            "message": { "columnName": "LogMessage" },
            "exception": { "columnName": "ErrorDetail" },
            "additionalColumns": [
              { "ColumnName": "EventType", "PropertyName": "EventType", "DataType": "nvarchar", "DataLength": 32 },
              { "ColumnName": "Source", "PropertyName": "SourceContext", "DataType": "nvarchar", "DataLength": 256 },
              { "ColumnName": "Operation", "PropertyName": "Operation", "DataType": "nvarchar", "DataLength": 256 },
              { "ColumnName": "DurationMs", "PropertyName": "Elapsed", "DataType": "float" },
              { "ColumnName": "HttpStatus", "PropertyName": "StatusCode", "DataType": "int" },
              { "ColumnName": "CorrelationRef", "PropertyName": "CorrelationId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "AppRegistrationId", "PropertyName": "AppRegistrationId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "PayerId", "PropertyName": "PayerId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "ProviderId", "PropertyName": "ProviderId", "DataType": "nvarchar", "DataLength": 64 },
              { "ColumnName": "UserEmail", "PropertyName": "UserEmail", "DataType": "nvarchar", "DataLength": 256 }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
