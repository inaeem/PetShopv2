{
  "ConnectionStrings": {
    "PetShopDb": "Server=QA_SQL_HOST;Database=PetShop;User Id=QA_USER;Password=__SET_VIA_ENV_OR_SECRET__;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": "https://qa.petshop.example.com",
    "AllowedHeaders": "Authorization,Content-Type",
    "AllowedMethods": "GET,POST,PUT,PATCH,DELETE,OPTIONS"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "Diagnostics": {
    "LayerTracing": {
      "Enabled": true,
      "Service": true,
      "Data": true,
      "Level": "Information",
      "IncludeArguments": false
    }
  }
}
